# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.
#
# mise loads .env.local via `[env] _.file` in mise.toml.

# Required by the portal-search CLIs (Composio).
COMPOSIO_API_KEY=

# Required for Google Workspace/Sheets/Drive lookups.
GOOGLE_API_KEY=

# Opts in to writing the tracker record. Without it, every write subcommand of
# scripts/tracker.py refuses to run. Set to 1 deliberately; do not leave it on
# in a shared or CI environment.
TRACKER_ALLOW_WRITES=

# Path to the service-account key (default: ~/.config/job-tracker/sa.json).
# TRACKER_SA_KEY=

# The spreadsheet the generated view is written to. Create it, share it with
# the service account as Editor, then paste its id here.
TRACKER_SHEET_ID=
