<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fetches Gmail every 12 hours, stages a proposal, and runs deferred syncs.

  This is the scheduled fetch. `dev.fnc314.tracker-collect` still handles
  requests queued by a write every 15 minutes; this job is what makes the
  12-hour mailbox read happen without an agent.

  It uses the credentials that already exist on this machine: the tracker
  service-account key on disk and the Composio CLI login for the Gmail
  connection. Nothing new is provisioned, and no secret is embedded here.

  Install:
    cp deploy/launchd/dev.fnc314.tracker-gmail-fetch.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.fnc314.tracker-gmail-fetch.plist

  Inspect:
    launchctl print gui/$(id -u)/dev.fnc314.tracker-gmail-fetch
    tail -f ~/Library/Logs/job-tracker-gmail-fetch.log

  Remove:
    launchctl bootout gui/$(id -u)/dev.fnc314.tracker-gmail-fetch
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.fnc314.tracker-gmail-fetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/fnc314/Work/Search/waleedtarbosh-ai-job-search/scripts/gmail-fetch.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/fnc314/Work/Search/waleedtarbosh-ai-job-search</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- The key is read from disk, never embedded here. -->
        <key>TRACKER_SA_KEY</key>
        <string>/Users/fnc314/.config/job-tracker/sa.json</string>
        <key>TRACKER_ALLOW_WRITES</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- 12 hours. launchd coalesces the missed run on wake. -->
    <key>StartInterval</key>
    <integer>43200</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/fnc314/Library/Logs/job-tracker-gmail-fetch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fnc314/Library/Logs/job-tracker-gmail-fetch.log</string>
</dict>
</plist>
