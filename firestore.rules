rules_version = '2';

// Job Search Tracker security rules.
//
// Client access is denied unconditionally. This store holds company names,
// recruiter contacts, rejection reasons, and compensation bands, and every
// consumer (the TUI, the local dashboard, the CLI) runs on this machine or
// under a service account. There is no web client, no Firebase Auth user, and
// no anonymous surface, so there is nothing a client rule could usefully
// permit.
//
// The Admin SDK bypasses these rules entirely, which is the intended posture:
// scripts/tracker.py is the only writer.
//
// If a client surface is ever added, replace the catch-all with an explicit
// match block pinned to a single verified uid. Do not add `allow read: if true`.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
